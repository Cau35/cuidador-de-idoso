function scr_license_config(){
// ====================================================================
// CONFIGURAÇÃO DE LICENÇA E METADADOS - FÁBIO SANTOS
// ====================================================================

#macro GAME_AUTHOR "Fábio Santos"
#macro GAME_EMAIL_INST "fabio.santos017@academico.ifs.edu.br"
#macro GAME_EMAIL_PART "fabio.filo@hotmail.com"
#macro GAME_ORCID "https://orcid.org/0009-0008-4584-0069"
#macro GAME_PHONE "+55 (79) 9 9626-2233"
#macro GAME_COMMERCIAL_ALLOWED false

// Log de verificação no console de saída do GameMaker
show_debug_message("==================================================");
show_debug_message("JOGO PROTEGIDO POR LICENÇA NÃO-COMERCIAL E ATRIBUIÇÃO");
show_debug_message("Autor: " + GAME_AUTHOR);
show_debug_message("Contato: " + GAME_EMAIL_PART);
show_debug_message("ORCID: " + GAME_ORCID);
show_debug_message("==================================================");

}
