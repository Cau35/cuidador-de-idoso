/// scr_personagens

function Personagem_Cuidador() constructor {

    nome = "Cuidador";
    tem_jaleco = false;

    // SEM JALECO
    spr_parado_baixo     = spr_phsj_parado_baixo;
    spr_parado_cima      = spr_phsj_parado_cima;
    spr_parado_direita   = spr_phsj_parado_direita;
    spr_parado_esquerda  = spr_phsj_parado_esquerda;

    spr_andando_baixo    = spr_phsj_caminhando_baixo;
    spr_andando_cima     = spr_phsj_caminhando_cima;
    spr_andando_direita  = spr_phsj_caminhando_direita;
    spr_andando_esquerda = spr_phsj_caminhando_esquerda;

    // COM JALECO
    spr_j_parado_baixo     = spr_phcj_parado_baixo;
    spr_j_parado_cima      = spr_phcj_parado_cima;
    spr_j_parado_direita   = spr_phcj_parado_direita;
    spr_j_parado_esquerda  = spr_phcj_parado_esquerda;

    spr_j_andando_baixo    = spr_phcj_caminhando_baixo;
    spr_j_andando_cima     = spr_phcj_caminhando_cima;
    spr_j_andando_direita  = spr_phcj_caminhando_direita;
    spr_j_andando_esquerda = spr_phcj_caminhando_esquerda;
}

function Personagem_Cuidadora() constructor {

