    spr_andando_baixo    = spr_acacia_caminhando_baixo;
    spr_andando_cima     = spr_acacia_caminhando_cima;
    spr_andando_direita  = spr_acacia_caminhando_direita;
    spr_andando_esquerda = spr_acacia_caminhando_esquerda;

    // COM JALECO
    // você completa depois, o código já suporta
