// Textos do Jogo
relato_colega = "Nossa, tô morta! O plantão hoje foi uma loucura. A filha do Seu João veio visitar e trouxe um bolo de laranja maravilhoso... Ah, sobre o Seu João: hoje de manhã, lá pelas 9h, ele teve um episódio de tosse bem seca. A novela da tarde tava ótima... Mas olha, fica de olho, porque desde o almoço a urina dele na sonda está bem escura e com um cheiro forte, e eu não tive tempo de anotar no sistema. A cama dele também tá rangendo...";

pergunta = "Quais itens você adiciona ao Prontuário Clínico para monitoramento noturno? (Selecione 2)";

texto_tutor = "Saber ouvir é fundamental, mas saber o que registrar salva vidas. A abstração é a sua capacidade de ignorar as distrações – como a novela ou o cansaço do colega – e extrair apenas a essência do problema: os sintomas (tosse e alteração na urina). Sem abstração, o prontuário vira um diário confuso; com ela, vira um instrumento médico preciso.";